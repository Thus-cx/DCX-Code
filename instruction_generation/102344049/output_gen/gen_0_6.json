import json

def generate_tasks():
    tasks = []
    objects = ["jug", "kettle", "teapot", "cup", "lamp", "battery_charger", "laptop", "phone_stand", "screwdriver", "baseballbat", "stuffed toy", "toy_fire_truck", "toy_vehicle", "cake_pan", "casserole", "plate"]
    rooms = ["living_room_0", "bedroom_0", "garage_0", "kitchen_0"]
    furniture = ["table_1", "table_0", "table_4", "counter_0", "cabinet_0", "cabinet_1", "cabinet_2", "bed_0", "chest_of_drawers_0", "chest_of_drawers_3", "bed_1", "chest_of_drawers_1", "chest_of_drawers_2", "bed_2", "chest_of_drawers_4", "wardrobe_0", "wardrobe_1", "toilet_0", "toilet_1", "toilet_2", "fridge_0", "fridge_1", "fridge_2", "couch_0", "couch_1", "chair_0", "chair_1", "chair_2", "chair_3", "shelf_0", "shelf_1", "shelf_2"]

    for i in range(5):
        task = {
            "instruction": "",
            "initial_state": []
        }

        objects_in_task = random.sample(objects, random.randint(1, 5))
        rooms_in_task = random.sample(rooms, random.randint(1, 3))

        for obj in objects_in_task:
            task["initial_state"].append({
                "number": 1,
                "object_classes": [obj],
                "furniture_names": [furniture[random.randint(0, len(furniture) - 1)]] if furniture else [],
                "allowed_regions": [rooms_in_task[random.randint(0, len(rooms_in_task) - 1)]] if rooms_in_task else []
            })

        for room in rooms_in_task:
            task["instruction"] += f"Move the {', '.join([obj for obj in objects_in_task if obj in objects])} from the living room to the {room} and "

        task["instruction"] = task["instruction"].strip() + "."

        if random.random() < 0.5:
            task["instruction"] += " Turn on/off the lamp, and clean the living room table."

        tasks.append(task)

    return json.dumps(tasks)

print(generate_tasks())
